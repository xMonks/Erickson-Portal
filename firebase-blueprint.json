{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "A participant in the coaching program",
      "type": "object",
      "properties": {
        "firstName": { "type": "string", "description": "First Name" },
        "lastName": { "type": "string", "description": "Last Name" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "countryCode": { "type": "string", "description": "Country Code" },
        "phone": { "type": "string", "description": "Phone number" },
        "company": { "type": "string", "description": "Company" },
        "designation": { "type": "string", "description": "Designation" },
        "gender": { "type": "string", "description": "Gender" },
        "batchNumber": { "type": "string", "description": "Batch Number" },
        "city": { "type": "string", "description": "City" },
        "industry": { "type": "string", "description": "Industry" },
        "linkedIn": { "type": "string", "description": "LinkedIn Profile URL" },
        "coachingJourney": { "type": "string", "description": "Coaching Journey Status" },
        "otherPrograms": { "type": "string", "description": "Any other program done from us?" },
        "cmm": { "type": "string", "description": "CMM" },
        "tcc": { "type": "string", "description": "TCC" },
        "tlc": { "type": "string", "description": "TLC" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["firstName", "email"]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Collection of all participants"
    }
  }
}
